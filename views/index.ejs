<!DOCTYPE html>
<html>
<head>
  <meta charset='utf-8' />
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css'/>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
        integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <style>
      table ,
      table th,
      table td {
        border: 1px solid #000000;
        border-collapse: collapse;
      }

      .content {
        width: 180px;
      }
      .data {
        width: 150px;
      }
      .check {
        width: 60px;
      }
      .del {
        width: 50px;
      }

      .simple-box1 {
    border: 2px solid #000000 ; /* 太さ2px、実践、黒色*/
    width: 550px ; /* 幅 */
    height: 150px ; /* 高さ */
    padding: 10px;
    }
    </style>
</head>
<body>
<%- include('./error_messages'); %>
<%- include('./header'); %>
<% if(isAuth) { %>
  <div class="container">
  <div class="row">
    <div class="col-md-6">
      <div class="simple-box1">
        <form action="/add" method="post" id="add-form">
          <label for="add-content">タスクの追加</label>
          <input required type="text" id="add-content" name="add" placeholder="何をする?"/><br>
          <label for="start-date">開始日　　　</label>
          <input required type="date" id="start-date" name="start_date"/>
          <label for="end_date">終了日　　　</label>
          <input required type="date" id="end_date" name="end_date"/>
          <input class="btn btn-primary" type="submit" value="追加" id="add-submit" disabled/>
          <div id="date-error" class="text-danger" style="display:none;">開始日は終了日より前の日付にしてください</div>
        </form>
      </div>

      <script>
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('add-form');
        const content = document.getElementById('add-content');
        const startInput = document.getElementById('start-date');
        const endInput = document.getElementById('end_date');
        const submitBtn = document.getElementById('add-submit');
        const errorMsg = document.getElementById('date-error');

        function validate() {
          const start = startInput.value;
          const end = endInput.value;
          const hasContent = content.value.trim().length > 0;
          const hasDates = start && end;
          const datesValid = hasDates && start <= end;

          errorMsg.style.display = (hasDates && !datesValid) ? 'block' : 'none';

          submitBtn.disabled = !(hasContent && datesValid);
        }

        [content, startInput, endInput].forEach(el => {
          el.addEventListener('input', validate);
          el.addEventListener('change', validate);
        });

        // 念のため送信時にも二重チェック
        form.addEventListener('submit', function(e) {
          if (submitBtn.disabled) {
            e.preventDefault();
          }
        });
      });
      </script><br>
      <div id="calendar" class="calendar"></div>
    </div>
    <div class="col-md-6">
      <form action="/check" method="post">
      <table>
        <thead>
          <tr>
            <th class="content">タスク</th>
            <th class="data">開始日</th>
            <th class="data">終了日</th>
            <th class="check">チェック</th>
            <th class="del">削除</th>
          </tr>
        </thead>
        <tbody>
       
        <% todos.forEach((todo, index) => { %>
          <%   const date = new Date(todo.event_date);
            const year = date.getFullYear();
            const month = ("0" + (date.getMonth() + 1)).slice(-2);
            const day = ("0" + date.getDate()).slice(-2);
            const week=date.getDay();
            const weekNames = ["日", "月", "火", "水", "木", "金", "土"];
            const weekName = weekNames[week];
            const formattedeDate = year + "-" + month + "-" + day + " (" + weekName + ")";
          %><%   const sdate = new Date(todo.start_date);
            const syear = sdate.getFullYear();
            const smonth = ("0" + (sdate.getMonth() + 1)).slice(-2);
            const sday = ("0" + sdate.getDate()).slice(-2);
            const sweek=sdate.getDay();
            const sweekNames = ["日", "月", "火", "水", "木", "金", "土"];
            const sweekName = sweekNames[sweek];
            const formattedsDate = syear + "-" + smonth + "-" + sday + " (" + sweekName + ")";
          %>
          <tr>
          <% if (todo.checked) { %>
          <td><del><span><%= todo.content %></span></del></td>
          <td><time><%= formattedsDate %></time></td>
          <td><time><%= formattedeDate %></time></td>
          <td><input type="checkbox" name="checked[<%= index %>]" value="1" checked></td>
          <td>
            <button type="submit"
                    formaction="/delete/<%= todo.id %>"
                    formmethod="post"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('このタスクを削除しますか?');">削除</button>
          </td>
        <% } else { %>
          <td><span><%= todo.content %></span></td>
          <td><time><%= formattedsDate %></time></td>
          <td><time><%= formattedeDate %></time></td>
          <td><input type="checkbox" name="checked[<%= index %>]" value="1"></td>
          <td>
            <button type="submit"
                    formaction="/delete/<%= todo.id %>"
                    formmethod="post"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('このタスクを削除しますか?');">削除</button>
          </td>
        <% } %>
            </tr>   
          <% }) %> 
        </tbody>
      </table>
      <br><input class="btn btn-primary" type="submit" value="保存"/>
      </form>
    </div>
  </div>
</div>
<% } else { %>
  <h1>Welcome to the TodoApp</h1>
  <a class="btn btn-primary" href="/signup" role="button">Sign up now!</a>
<% } %>
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.6/umd/popper.min.js"
        integrity="sha384-wHAiFfRlMFy6i5SRaxvfOCifBUQy1xHdJ/yoi7FRNXMRBu5WHdZYu1hA6ZOblgut"
        crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js"
        integrity="sha384-B0UglyR+jN6CkvvICOB2joaf5I4l3gm9GU6Hc1og6Ls7i6U/mkkaduKaBhlAXv9k"
        crossorigin="anonymous"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
      locale: 'ja',
      themeSystem: 'bootstrap5',
      initialView: 'dayGridMonth',
      height: 500,
      fontsize: '10px',
      headerToolbar: {
        left: 'prevYear,prev,next,nextYear today',
        center: 'title',
        right: ''//'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
      },
      buttonText: {
        //today: '今日',      // todayの表示ラベル
        //month: '月表示',    // dayGridMonthの表示ラベル
        //week: '週表示',     // timeGridWeekの表示ラベル
        //day: '日表示',      // timeGridDayの表示ラベル
      },
      buttonIcons: {  // 要Bootstrap-icons
        prev: 'chevron-left',      // 前月のアイコン
        next: 'chevron-right',     // 来月のアイコン
        prevYear: 'chevrons-left', // 前年のアイコン
        nextYear: 'chevrons-right' // 来年のアイコン
      },
      
      events: '/events.json'
    });
    calendar.render();
  });

</script>
</body>