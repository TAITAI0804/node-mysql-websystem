<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css'/>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
        integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS" crossorigin="anonymous">
</head>
<body>
<%- include('./error_messages'); %>
<%- include('./header'); %>
<% if(isAuth) { %>
  <div class="container">
  <div class="row">
    <div class="col-md-6">
      <form action="/add" method="post">
        <label>タスクの追加</label>
        <input required type="text" name="add" placeholder="何をする?"/><br>
        <label>期限　　　　</label>
        <input type="date" id="date" name="date"/>
        <input class="btn btn-primary" type="submit" value="追加"/>
      </form>
    </div>
    <div class="col-md-6">
      <ul>
        <form action="/check" method="post">
        <% todos.forEach((todo, index) => { %>
          <%   const date = new Date(todo.event_date);
            const year = date.getFullYear();
            const month = ("0" + (date.getMonth() + 1)).slice(-2);
            const day = ("0" + date.getDate()).slice(-2);
            const week=date.getDay();
            const weekNames = ["日", "月", "火", "水", "木", "金", "土"];
            const weekName = weekNames[week];
            const formattedDate = year + "-" + month + "-" + day + " (" + weekName + ")";
          %>
          <% if (todo.checked) { %>
            <li><del><span><%= todo.content %></span> (<time><%= formattedDate %></time>) <input type="checkbox" name="checked[<%= index %>]" value="1" <%= todo.checked ? 'checked' : '' %>></del></li>
          <% } else { %>
             <li><span><%= todo.content %></span> (<time><%= formattedDate %></time>) <input type="checkbox" name="checked[<%= index %>]" value="1" <%= todo.checked ? 'checked' : '' %>></li>
          <% } %>
            <input type="hidden" name="checked_id[<%= index %>]" value="<%= todo.id %>">
          <% }) %>
          <input class="btn btn-primary" type="submit" value="保存"/>
          </form>
      </ul>
    </div>
  </div>
</div>
<% } else { %>
  <h1>Welcome to the TodoApp</h1>
  <a class="btn btn-primary" href="/signup" role="button">Sign up now!</a>
<% } %>
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
        integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
        crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.6/umd/popper.min.js"
        integrity="sha384-wHAiFfRlMFy6i5SRaxvfOCifBUQy1xHdJ/yoi7FRNXMRBu5WHdZYu1hA6ZOblgut"
        crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js"
        integrity="sha384-B0UglyR+jN6CkvvICOB2joaf5I4l3gm9GU6Hc1og6Ls7i6U/mkkaduKaBhlAXv9k"
        crossorigin="anonymous"></script>
</body>